{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "issues": "${mod_issues}",
    "sources": "${mod_homepage}"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.sythiex.hearthstonemod.fabric.HearthstoneFabricMod"
    ],
    "client": [
      "com.sythiex.hearthstonemod.fabric.HearthstoneFabricClient"
    ],
    "modmenu": [
      "com.sythiex.hearthstonemod.fabric.HearthstoneModMenuIntegration"
    ]
  },
  "mixins": [
    "hearthstonemod.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "fabric-api": "*"
  }
}
